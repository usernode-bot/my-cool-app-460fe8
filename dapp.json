{
  "name": "Run Club",
  "icon": {
    "emoji": "🏃"
  },
  "secrets": [],
  "tests": [
    {
      "name": "Home lists upcoming runs",
      "path": "/",
      "expectText": "Staging demo: Riverside Park"
    },
    {
      "name": "New Run sheet opens",
      "path": "/#new",
      "expectSelector": "#post-run-btn"
    },
    {
      "id": "home.card-actions",
      "name": "Run cards carry inline quick actions",
      "path": "/",
      "expectSelector": "#run-list .run-card .card-actions .card-share-btn",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js",
        "styles/**"
      ]
    },
    {
      "name": "Mine deep link opens the Mine list empty state",
      "path": "/?mine=1",
      "expectText": "MY RUNS",
      "expectSelector": "#tab-mine[data-tab='mine']"
    },
    {
      "name": "Plain home load keeps Upcoming selected",
      "path": "/",
      "expectText": "UPCOMING RUNS",
      "expectSelector": "#run-list .run-card .card-actions .card-share-btn"
    },
    {
      "name": "Home cards do not offer actions that need an organizer identity",
      "path": "/",
      "expectText": "Staging demo: Harbor Promenade",
      "expectSelector": "#run-list .run-card .card-actions .card-view-btn"
    },
    {
      "name": "Run details shows Who's Going",
      "path": "/#run/900001",
      "expectText": "staging-demo-maya"
    },
    {
      "name": "Time format toggle defaults to am/pm",
      "path": "/",
      "expectSelector": "#app[data-time-format='12'] #tf-12[aria-pressed='true']"
    },
    {
      "name": "Home renders 24 hour times",
      "path": "/?tf=24",
      "expectSelector": "#app[data-time-format='24'] .run-time"
    },
    {
      "name": "Run details renders 24 hour times",
      "path": "/?tf=24#run/900001",
      "expectSelector": "#app[data-time-format='24'] #detail-body .run-time"
    },
    {
      "name": "Run detail shows the seeded photo",
      "path": "/#run/900001",
      "expectSelector": "#detail-photo"
    },
    {
      "id": "home.display-mode",
      "name": "Header carries the display mode icon",
      "path": "/",
      "expectSelector": "#theme-btn[data-theme-mode='system'][aria-label='Display mode: System']",
      "visual": true,
      "impact": [
        "public/index.html",
        "tailwind.config.js",
        "styles/**"
      ]
    },
    {
      "name": "Home renders in dark mode",
      "path": "/?theme=dark",
      "expectSelector": "html.dark #app #theme-btn[data-theme-mode='dark'][aria-label='Display mode: Dark']"
    },
    {
      "name": "Run details renders in dark mode",
      "path": "/?theme=dark#run/900001",
      "expectSelector": "html.dark #screen-detail:not(.hidden) #theme-btn-detail[data-theme-mode='dark'][aria-label='Display mode: Dark']"
    }
  ],
  "visibility": {
    "build": "public",
    "view": "public"
  }
}
