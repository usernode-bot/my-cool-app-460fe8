{
  "name": "Run Club",
  "icon": {
    "emoji": "🏃"
  },
  "secrets": [],
  "tests": [
    {
      "name": "Home lists upcoming runs",
      "path": "/",
      "expectText": "Staging demo: Riverside Park"
    },
    {
      "name": "New Run sheet opens",
      "path": "/#new",
      "expectSelector": "#post-run-btn"
    },
    {
      "name": "New Run sheet shows the Type row",
      "path": "/#new",
      "expectSelector": "#type-row"
    },
    {
      "name": "New Run sheet shows the Duration row",
      "path": "/#new",
      "expectSelector": "#duration-row"
    },
    {
      "name": "New Run sheet offers day picks",
      "path": "/#new",
      "expectSelector": "#when-days [data-day='today']"
    },
    {
      "name": "New Run sheet offers start times",
      "path": "/#new",
      "expectSelector": "#when-times [data-time='07:00']"
    },
    {
      "name": "New Run summary follows a 24 hour locale",
      "path": "/?locale=en-GB#new",
      "expectSelector": "#when-picks[data-time-format='24'] #when-summary .run-time"
    },
    {
      "id": "new-run.when-picks",
      "name": "New Run sheet shows quick date and time picks",
      "path": "/#new",
      "expectSelector": "#when-summary .run-time",
      "visual": true,
      "impact": [
        "public/**"
      ]
    },
    {
      "name": "Run type renders on the board",
      "path": "/",
      "expectText": "Staging demo: Trail"
    },
    {
      "name": "Duration renders on the board",
      "path": "/",
      "expectText": "30 min"
    },
    {
      "name": "Run detail shows the Type row",
      "path": "/#run/900001",
      "expectSelector": "#detail-body [data-type='1']",
      "expectText": "Staging demo: Trail"
    },
    {
      "name": "Typeless run detail keeps its facts unchanged",
      "path": "/#run/900003",
      "expectSelector": "#detail-body [data-type='0']"
    },
    {
      "name": "Run detail shows the Duration row",
      "path": "/#run/900001",
      "expectSelector": "#detail-body [data-duration='1']",
      "expectText": "30 min"
    },
    {
      "name": "Durationless run detail keeps its facts unchanged",
      "path": "/#run/900003",
      "expectSelector": "#detail-body [data-duration='0']"
    },
    {
      "id": "new-run.type-row",
      "name": "New Run sheet carries the Type row",
      "path": "/#new",
      "expectSelector": "#type-row",
      "visual": true,
      "impact": [
        "public/**",
        "server.js"
      ]
    },
    {
      "id": "new-run.duration-row",
      "name": "New Run sheet carries the Duration row",
      "path": "/#new",
      "expectSelector": "#duration-row",
      "visual": true,
      "impact": [
        "public/**",
        "server.js"
      ]
    },
    {
      "name": "Run details shows Who's Going",
      "path": "/#run/900001",
      "expectText": "staging-demo-maya"
    },
    {
      "name": "Time format defaults to Auto",
      "path": "/",
      "expectSelector": "#app[data-time-format-mode='auto'] #tf-auto[aria-pressed='true']"
    },
    {
      "name": "12 hour locale renders am/pm times",
      "path": "/?locale=en-US",
      "expectSelector": "#app[data-time-format='12'] .run-time"
    },
    {
      "name": "24 hour locale renders 24 hour times",
      "path": "/?locale=en-GB",
      "expectSelector": "#app[data-time-format='24'] .run-time"
    },
    {
      "name": "Manual override beats locale",
      "path": "/?locale=en-US&tf=24",
      "expectSelector": "#app[data-time-format-mode='24'][data-time-format='24'] .run-time"
    },
    {
      "name": "Run details renders the chosen format",
      "path": "/?locale=en-GB&tf=12#run/900001",
      "expectSelector": "#app[data-time-format='12'] #detail-body .run-time"
    },
    {
      "name": "Run detail shows the seeded photo",
      "path": "/#run/900001",
      "expectSelector": "#detail-photo"
    },
    {
      "name": "Run detail shows the meeting point",
      "path": "/#run/900001",
      "expectSelector": "#detail-body .staticmap",
      "expectText": "Staging demo: Main gate"
    },
    {
      "name": "New Run sheet shows the Meet at row",
      "path": "/#new",
      "expectSelector": "#meeting-row"
    },
    {
      "id": "run.meeting-pin",
      "name": "Meeting point renders on run details",
      "path": "/#run/900001",
      "expectSelector": "#detail-body .staticmap",
      "expectText": "Staging demo: Main gate",
      "visual": true,
      "impact": ["public/index.html", "styles/**", "server.js"]
    },
    {
      "id": "home.display-mode",
      "name": "Header carries the display mode icon",
      "path": "/",
      "expectSelector": "#theme-btn[data-theme-mode='system'][aria-label='Display mode: System']",
      "visual": true,
      "impact": [
        "public/index.html",
        "tailwind.config.js",
        "styles/**"
      ]
    },
    {
      "name": "Home renders in dark mode",
      "path": "/?theme=dark",
      "expectSelector": "html.dark #app #theme-btn[data-theme-mode='dark'][aria-label='Display mode: Dark']"
    },
    {
      "name": "Run details renders in dark mode",
      "path": "/?theme=dark#run/900001",
      "expectSelector": "html.dark #screen-detail:not(.hidden) #theme-btn-detail[data-theme-mode='dark'][aria-label='Display mode: Dark']"
    },
    {
      "name": "Run details menu offers Share",
      "path": "/#run/900001",
      "expectSelector": "#more-btn[aria-label*='Share']"
    },
    {
      "name": "Run details menu offers reminders",
      "path": "/#run/900001",
      "expectSelector": "#more-btn[aria-label*='reminders']"
    },
    {
      "id": "reminders.toggle",
      "name": "Reminder toggle reachable on run details",
      "path": "/#run/900001",
      "expectSelector": "#more-btn[aria-label*='reminders']",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js"
      ]
    },
    {
      "id": "kudos.past-run",
      "name": "Past run shows Kudos count",
      "path": "/#tab-past",
      "expectSelector": "#screen-home .kudos-btn",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js"
      ]
    },
    {
      "name": "Past run detail shows Kudos button",
      "path": "/#run/900003",
      "expectSelector": "#kudos-btn"
    },
    {
      "name": "Past run detail shows the kudos count",
      "path": "/#run/900003",
      "expectText": "3"
    },
    {
      "name": "Run detail shows the comment thread",
      "path": "/#run/900001",
      "expectSelector": "#comments-section #comment-list",
      "expectText": "Staging demo comment: bringing the water vests."
    },
    {
      "name": "Comments render newest last",
      "path": "/#run/900001",
      "expectSelector": "#comment-list .comment-delete",
      "expectText": "save me a spot"
    }
  ],
  "visibility": {
    "build": "public",
    "view": "public"
  }
}
